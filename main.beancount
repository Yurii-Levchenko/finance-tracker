; Облік Олі й Марка. Операції й звірку з банком генерує import.py у transactions.beancount.
; Чия операція — тег #olya або #marko; категорії витрат спільні.

option "title" "Фінанси Олі й Марка"
option "operating_currency" "PLN"

; Рахунки
2026-07-31 open Assets:Банк:Поточний          PLN
2026-07-31 open Assets:Банк:Марко             PLN
; Готівка: витрати з неї додають з телефона на сторінці app.py (стартовий залишок 0).
2026-07-31 open Assets:Готівка:Оля            PLN
2026-07-31 open Assets:Готівка:Марко          PLN
2026-07-31 open Equity:Початковий-Залишок     PLN

2026-07-31 open Income:Зарплата               PLN
2026-07-31 open Income:Інше                   PLN

2026-07-31 open Expenses:Житло                PLN
2026-07-31 open Expenses:Продукти             PLN
2026-07-31 open Expenses:Кафе                 PLN
2026-07-31 open Expenses:Доставка-Їжі         PLN
2026-07-31 open Expenses:Транспорт            PLN
2026-07-31 open Expenses:Підписки             PLN
2026-07-31 open Expenses:Звязок               PLN
2026-07-31 open Expenses:Дім-і-Косметика      PLN
2026-07-31 open Expenses:Спорт                PLN
2026-07-31 open Expenses:Комунальні           PLN
2026-07-31 open Expenses:Розваги              PLN
2026-07-31 open Expenses:Покупки              PLN
2026-07-31 open Expenses:Без-Категорії        PLN

; Початкові залишки на 31.07.2026
2026-07-31 * "Початковий залишок" #olya
  Assets:Банк:Поточний       4500.00 PLN
  Equity:Початковий-Залишок

2026-07-31 * "Початковий залишок" #marko
  Assets:Банк:Марко          2860.40 PLN
  Equity:Початковий-Залишок

; Збережені запити (у Fava — вкладка Query). Місяць показано його першим днем.
2026-07-31 query "1 Витрати за категоріями" "
  SELECT yearmonth(date) AS month, account, sum(number) AS amount
  WHERE root(account, 1) = 'Expenses'
  GROUP BY month, account
  ORDER BY month, amount DESC"

2026-07-31 query "2 Норма заощаджень" "
  SELECT yearmonth(date) AS month,
         -sum(number * int(root(account, 1) = 'Income')) AS income,
         sum(number * int(root(account, 1) = 'Expenses')) AS expenses,
         -sum(number) AS saved,
         round(100 * sum(number) / sum(number * int(root(account, 1) = 'Income')), 1) AS rate_pct,
         max(date) AS last_operation
  WHERE root(account, 1) IN ('Income', 'Expenses')
  GROUP BY month
  ORDER BY month"

2026-07-31 query "3 Фіксовані і змінні" "
  SELECT yearmonth(date) AS month,
         sum(number * int('fixed' IN tags)) AS fixed,
         sum(number * int(NOT 'fixed' IN tags)) AS variable,
         sum(number) AS total
  WHERE root(account, 1) = 'Expenses'
  GROUP BY month
  ORDER BY month"

2026-07-31 query "4 Без категорії" "
  SELECT yearmonth(date) AS month, date, narration, number AS amount
  WHERE account = 'Expenses:Без-Категорії'
  ORDER BY date"

; Наростаючий підсумок change по місяцях = гроші на всіх рахунках (Assets) на кінець місяця.
2026-07-31 query "5 Рух по рахунках" "
  SELECT yearmonth(date) AS month, sum(number) AS change, max(date) AS last_operation
  WHERE root(account, 1) = 'Assets'
  GROUP BY month
  ORDER BY month"

include "transactions.beancount"
